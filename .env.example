# =============================================================================
# Malli & Co. — Vercel Production & Local Environment Template
# Duplicate this file to .env.local for local development,
# and add these variables to your Vercel Project Settings > Environment Variables.
# =============================================================================

# 1. MongoDB Atlas Configuration (Rule 5 compliant)
# Standard SRV connection string from MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/malli-co?retryWrites=true&w=majority

# (Optional) Direct replica-set connection string fallback
MONGODB_DIRECT_URI=mongodb://<user>:<password>@cluster-shard-00-00.mongodb.net:27017,cluster-shard-00-01.mongodb.net:27017,cluster-shard-00-02.mongodb.net:27017/malli-co?ssl=true&replicaSet=atlas-shard-0&authSource=admin&retryWrites=true&w=majority

# 2. Application Base URL
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

# 3. Auth.js / NextAuth v5 Configuration
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-32-character-random-secret-here
# Trust host headers from custom domain deployments (e.g. malliandco.com)
AUTH_TRUST_HOST=true

# Google OAuth Credentials (Google Sign-In & Sign-Up)
AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-client-secret
# Or standard aliases:
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# 4. Razorpay Payments (INR transactions in paise - Rule 1 & 2 compliant)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# 5. Vercel Cron Secret (for /api/cron/release-unpaid-orders)
# Generate with: openssl rand -hex 16
CRON_SECRET=your-cron-secret-token-here

# 6. Cloudflare R2 Object Storage (High performance, S3-compatible, zero egress costs)
R2_ACCOUNT_ID=82f82e50e85cd74b78420fa00122c226
R2_BUCKET_NAME=malli-and-co
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
# Optional: Set this to your Public R2.dev URL or Custom Domain (e.g. https://pub-xxxx.r2.dev)
R2_PUBLIC_URL=https://pub-your-subdomain.r2.dev

# 7. Cloudinary (Alternative media storage for banners & product images)
CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# 8. ImageKit CDN Storage (Automated image compression & delivery)
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id

# 9. Initial Seed Credentials (used by scripts/seed-admin.ts)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@malliandco.com
ADMIN_PASSWORD=your_secure_admin_password

