# =============================================================================
# Malli & Co. — Vercel Production & Local Environment Template
# Duplicate this file to .env.local for local development,
# and add these variables to your Vercel Project Settings > Environment Variables.
# =============================================================================

# 1. MongoDB Atlas Configuration (Rule 5 compliant)
# Standard SRV connection string from MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/malli-co?retryWrites=true&w=majority

# (Optional) Direct replica-set connection string fallback
MONGODB_DIRECT_URI=mongodb://<user>:<password>@cluster-shard-00-00.mongodb.net:27017,cluster-shard-00-01.mongodb.net:27017,cluster-shard-00-02.mongodb.net:27017/malli-co?ssl=true&replicaSet=atlas-shard-0&authSource=admin&retryWrites=true&w=majority

# 2. Application Base URL
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

# 3. Auth.js / NextAuth v5 Configuration
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-32-character-random-secret-here

# 4. Razorpay Payments (INR transactions in paise - Rule 1 & 2 compliant)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# 5. Vercel Cron Secret (for /api/cron/release-unpaid-orders)
# Generate with: openssl rand -hex 16
CRON_SECRET=your-cron-secret-token-here

# 6. Cloudinary (Optional media storage for banners & product images)
CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# 7. Initial Seed Credentials (used by scripts/seed-admin.ts)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@malliandco.com
ADMIN_PASSWORD=your_secure_admin_password

